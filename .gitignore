# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Virtual environments ────────────────────────────────────────────────
venv/
ENV/
env/
.venv/

# ── RoadLens runtime artifacts (regenerated by run_demo.py) ─────────────
# NOTE: dashboard/demo_data.js is intentionally COMMITTED so the dashboard
# opens standalone without installing the ML stack.
roadlens.db
*.db
*.db-journal
*.db-wal
output/
dbdata/

# ── ML model weights (downloaded from Hugging Face, cached) ─────────────
*.pt
*.engine
# The browser build needs this one checked in (45 MB) — it is the whole
# reason the site can run inference with no server.
*.onnx
!dashboard/model/*.onnx

# ── Testing / coverage ──────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# ── Evidence images (keep the curated dataset samples) ──────────────────
*.jpg
*.jpeg
*.png
!data/samples/*.jpg
!docs/screenshots/*.png

# ── Editors / OS ────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Local reference material — never publish ────────────────────────────
_reference/
*INTERVIEW_GUIDE*
